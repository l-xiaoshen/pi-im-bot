{
  "name": "pi-im-bot",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.4",
  "workspaces": [
    "apps/*",
    "services/*",
    "pkgs/*"
  ],
  "scripts": {
    "dev": "bun scripts/dev.ts",
    "dev:bot": "bun --filter @pi-im-bot/bot dev",
    "dev:web": "bun --filter @pi-im-bot/web dev",
    "start": "bun --filter @pi-im-bot/bot start",
    "start:bot": "bun --filter @pi-im-bot/bot start",
    "start:web": "bun --filter @pi-im-bot/web start",
    "build": "bun run build:web",
    "build:web": "bun --filter @pi-im-bot/web build",
    "preview:plugins": "bun scripts/preview-plugin-center.ts",
    "pack:plugin": "bun scripts/pack-plugin.ts",
    "share:export": "bun scripts/export-source.ts",
    "check": "tsc --noEmit",
    "test": "bun test tests",
    "format": "bunx --bun prettier --write apps pkgs services scripts tests config/*.example.json",
    "format:check": "bunx --bun prettier --check apps pkgs services scripts tests config/*.example.json"
  },
  "devDependencies": {
    "@earendil-works/chord": "1.5.0",
    "@earendil-works/pi-ai": "1.5.0",
    "@earendil-works/pi-coding-agent": "1.5.0",
    "@earendil-works/pi-durable": "1.5.0",
    "@earendil-works/pi-mcp": "1.5.0",
    "@hono/standard-validator": "0.4.1",
    "@types/bun": "1.4.4",
    "bun": "1.4.4",
    "hono": "4.13.17",
    "prettier": "3.6.2",
    "typescript": "7.0.2",
    "zod": "4.6.7",
    "@pi-im-bot/agent": "workspace:*",
    "@pi-im-bot/artifacts": "workspace:*",
    "@pi-im-bot/bot": "workspace:*",
    "@pi-im-bot/channels": "workspace:*",
    "@pi-im-bot/config": "workspace:*",
    "@pi-im-bot/contracts": "workspace:*",
    "@pi-im-bot/conversations": "workspace:*",
    "@pi-im-bot/execution": "workspace:*",
    "@pi-im-bot/integrations": "workspace:*",
    "@pi-im-bot/jobs": "workspace:*",
    "@pi-im-bot/media": "workspace:*",
    "@pi-im-bot/messages": "workspace:*",
    "@pi-im-bot/permissions": "workspace:*",
    "@pi-im-bot/plugins": "workspace:*",
    "@pi-im-bot/providers": "workspace:*",
    "@pi-im-bot/resources": "workspace:*",
    "@pi-im-bot/runtime": "workspace:*",
    "@pi-im-bot/scheduler": "workspace:*",
    "@pi-im-bot/settings": "workspace:*",
    "@pi-im-bot/storage": "workspace:*",
    "@pi-im-bot/support": "workspace:*",
    "@pi-im-bot/web": "workspace:*"
  },
  "trustedDependencies": [
    "bun"
  ]
}
