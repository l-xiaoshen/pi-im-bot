{
  "name": "pi-im-bot",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.4",
  "workspaces": [
    "apps/*",
    "services/*",
    "pkgs/*"
  ],
  "scripts": {
    "dev": "bun scripts/dev.ts",
    "dev:bot": "bun --filter @pi-im-bot/bot dev",
    "dev:web": "bun --filter @pi-im-bot/web dev",
    "start": "bun --filter @pi-im-bot/bot start",
    "start:bot": "bun --filter @pi-im-bot/bot start",
    "start:web": "bun --filter @pi-im-bot/web start",
    "build": "bun run build:web",
    "build:web": "bun --filter @pi-im-bot/web build",
    "pack:plugin": "bun scripts/pack-plugin.ts",
    "share:export": "bun scripts/export-source.ts",
    "check": "tsc --noEmit",
    "format": "bunx --bun prettier --write apps pkgs services scripts config/*.example.json",
    "format:check": "bunx --bun prettier --check apps pkgs services scripts config/*.example.json"
  },
  "devDependencies": {
    "@types/bun": "1.4.4",
    "bun": "1.4.4",
    "hono": "4.13.18",
    "prettier": "3.10.1",
    "typescript": "7.0.2",
    "zod": "4.6.7",
    "@pi-im-bot/jobs": "workspace:*",
    "@pi-im-bot/plugins": "workspace:*",
    "@pi-im-bot/storage": "workspace:*",
    "@pi-im-bot/support": "workspace:*"
  },
  "trustedDependencies": [
    "bun"
  ]
}
