# Optional startup directories; relative paths are resolved by the existing loader.
# BOT_CONFIG_DIR=./config
# BOT_DATA_DIR=./data

# Independent browser application and bot API.
BOT_WEB_ORIGINS=http://localhost:3000
BOT_PUBLIC_ORIGIN=http://localhost:19335
WEB_PORT=3000
# PLUGIN_PREVIEW_PORT=19336

# Optional: point apiKeyEnv in config/providers.json at this variable.
PRIMARY_API_KEY=

# Optional: agent.execution.apiKeyEnv can reference the existing Bay credential.
BAY_API_KEY=
